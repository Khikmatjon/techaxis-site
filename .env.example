# Nusxa oling: .env.example -> .env. Qiymatlarni faqat .env va Vercel (Environment Variables) ga yozing.
# Bu faylga HECH QACHON haqiqiy qiymat yozmang: repo PUBLIC.

# Supabase Postgres ulanishi (pooler) — ilova shu orqali ulanadi
DATABASE_URL=
# Prisma db push / migratsiya uchun to'g'ridan-to'g'ri ulanish (ixtiyoriy; bo'sh bo'lsa DATABASE_URL ishlatiladi)
DIRECT_URL=

# Sessiya (JWT) imzo kaliti: uzun, tasodifiy qator. MAJBURIY: kodda zaxira kalit yo'q, bo'lmasa kirish ishlamaydi
JWT_SECRET=

# Admin foydalanuvchini yaratish uchun (faqat prisma/seed.ts ishlatadi)
ADMIN_PASSWORD=

# Supabase (Storage: to'lov cheklarini yuklash) — brauzerga ochiq kalitlar
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Telegram xabarnomalar (ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
