generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  hash            String
  role            String         @default("student") // "student", "admin"
  enrolledCourses String[]       // PostgreSQL array of strings ['courseId1']
  pendingPayments String[]
  payments        Payment[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Payment {
  id         String   @id @default(uuid())
  courseId   String
  plan       String
  amount     Float
  method     String
  status     String
  receiptUrl String?

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Course {
  id              String    @id @default(uuid())
  title           String
  subtitle        String
  description     String
  price           Int
  priceUZS        Int
  discountPercent Int       @default(0)
  thumbnail       String
  instructor      String
  instructorAvatar String
  level           String
  duration        String
  studentsCount   Int       @default(0)
  rating          Float     @default(0)
  tags            String[]
  isActive        Boolean   @default(true)
  modules         Module[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Module {
  id        String    @id @default(uuid())
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  lessons   Lesson[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Lesson {
  id        String    @id @default(uuid())
  moduleId  String
  module    Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  duration  String
  videoUrl  String?
  pdfUrl    String?
  text      String?
  images    String[]
  isFree    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
